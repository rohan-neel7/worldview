# ==============================================================================
# WORLDVIEW ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and populate with your replacement credentials.
# NEVER commit your actual .env file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# CLIENT-SAFE CONFIGURATION (Browser Visible)
# ------------------------------------------------------------------------------
# Google Maps API Key for Photorealistic 3D Tiles in WebGL (CesiumJS).
# IMPORTANT: Restrict this key in Google Cloud Console via HTTP Referrer restrictions!
VITE_GOOGLE_MAPS_KEY=

# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (Never exposed to browser bundles)
# ------------------------------------------------------------------------------
# Primary Google Gemini Pro API Key for real-time crisis intelligence summaries
GEMINI_API_KEY_1=

# Optional fallback Google Gemini API Key
GEMINI_API_KEY_2=

# AISStream WebSocket API Key for real-time global maritime vessel tracking
AISSTREAM_API_KEY=

# Express API Server Port (Default: 3001)
PORT=3001

# Optional daily limit for Gemini AI API calls across all clients (Default: 500)
GEMINI_DAILY_LIMIT=500
